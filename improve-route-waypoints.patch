index 0000000..997d3b1
--- /dev/null
+++ b/src/components/route/RouteWaypoints.jsx
@@ -0,0 +1,24 @@
+/** Numbered navigation waypoints for the planned route: the list a crew would read out. */
+export default function RouteWaypoints({ route }) {
+  if (!route?.waypoints?.length) return null;
+  const ns = (lat) => `${Math.abs(lat).toFixed(2)}°${lat >= 0 ? 'N' : 'S'}`;
+
+  return (
+    <section className="rm-card rm-waypoints">
+      <h3>Waypoints <span className="rm-count">{route.waypoints.length}</span></h3>
+      <ol>
+        <li><span className="rm-wp__n rm-wp__n--start">S</span><div><strong>{route.start.name}</strong><small>Start · {ns(route.start.lat)}, {route.start.lon.toFixed(2)}°E</small></div></li>
+        {route.waypoints.map((w) => (
+          <li key={w.n}>
+            <span className="rm-wp__n">{w.n}</span>
+            <div>
+              <strong>{w.kind === 'stop' ? w.name : `Waypoint ${w.n}`}</strong>
+              <small>km {w.km} · {ns(w.lat)}, {w.lon.toFixed(2)}°E{w.elevKm != null && ` · ${w.elevKm} km elev`}{w.kind === 'stop' ? ' · science stop' : ' · change of direction'}</small>
+            </div>
+          </li>
+        ))}
+        <li><span className="rm-wp__n rm-wp__n--end">E</span><div><strong>{route.end.name}</strong><small>Destination · km {route.distanceKm}</small></div></li>
+      </ol>
+    </section>
+  );
+}
