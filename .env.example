# Optional: override the NASA Mars Trek elevation (DEM) tile template used by the route planner.
# {z}/{y}/{x}/{ext} are filled in by the app. The tiles must be grey-scale elevation images;
# the app checks them against known landing-site heights and falls back to simulated terrain if they do not match.
# VITE_MARS_DEM_URL=https://trek.nasa.gov/tiles/Mars/EQ/Mars_MGS_MOLA_DEM_mosaic_global_463m/1.0.0/default/default028mm/{z}/{y}/{x}.{ext}
