+/** Slope, low ground and climbing met along a straight run of cells. Used to compare "what a bend avoids". */
+function measureLine(grid, depth, pts) {
+  let maxSlope = 0, maxDepth = 0, climb = 0, minElev = Infinity, km = 0
+  let prev = null
+  for (let i = 0; i < pts.length - 1; i++) {
+    const { fx: x0, fy: y0 } = pts[i], { fx: x1, fy: y1 } = pts[i + 1]
+    const n = Math.max(1, Math.ceil(Math.hypot(x1 - x0, y1 - y0) * 2))
+    const ym = Math.round((y0 + y1) / 2)
+    const step = Math.hypot((x1 - x0) * grid.dxRow[ym], (y1 - y0) * grid.dy) / n
+    for (let k = 0; k <= n; k++) {
+      const x = x0 + ((x1 - x0) * k) / n, y = y0 + ((y1 - y0) * k) / n
+      const h = bilinear(grid, x, y)
+      minElev = Math.min(minElev, h)
+      maxDepth = Math.max(maxDepth, bilinear(grid, x, y, depth))
+      if (prev !== null && step > 0) {
+        maxSlope = Math.max(maxSlope, Math.atan(Math.abs(h - prev) / step) / RAD)
+        climb += Math.max(0, h - prev)
+        km += step
+      }
+      prev = h
+    }
+  }
+  return { maxSlopeDeg: +maxSlope.toFixed(1), maxDepthKm: +maxDepth.toFixed(2), climbKm: +climb.toFixed(2), minElevKm: +minElev.toFixed(2), km: +km.toFixed(1) }
+}
+
+/** Map a catalogue source string ("MRO CRISM", "Curiosity REMS"...) to a short chip key. */
+export function sourceKey(src = '') {
