diff --git a/src/lib/commsDelay.js b/src/lib/commsDelay.js
index e69de29..0d8203b 100644
--- a/src/lib/commsDelay.js
+++ b/src/lib/commsDelay.js
@@ -0,0 +1,51 @@
+// Earth-Mars distance and radio delay for a given date, from approximate Keplerian elements
+// (JPL "Approximate Positions of the Planets", valid 1800-2050, accuracy of a few 0.001 AU).
+
+import { julianDay } from './marsTime.js'
+
+const RAD = Math.PI / 180
+const AU_KM = 149597870.7
+const C_KM_S = 299792.458
+
+// [value at J2000, rate per Julian century]
+const ELEMENTS = {
+  earth: { a: [1.00000261, 0.00000562], e: [0.01671123, -0.00004392], I: [-0.00001531, -0.01294668], L: [100.46457166, 35999.37244981], w: [102.93768193, 0.32327364], O: [0, 0] },
+  mars:  { a: [1.52371034, 0.00001847], e: [0.0933941, 0.00007882],   I: [1.84969142, -0.00813131],  L: [-4.55343205, 19140.30268499], w: [-23.94362959, 0.44441088], O: [49.55953891, -0.29257343] },
+}
+
+function heliocentric(el, T) {
+  const v = (k) => el[k][0] + el[k][1] * T
+  const a = v('a'), e = v('e'), I = v('I') * RAD
+  const w = v('w'), O = v('O')
+  const M = (((v('L') - w) % 360) + 360) % 360 * RAD
+  let E = M + e * Math.sin(M)
+  for (let i = 0; i < 12; i++) E -= (E - e * Math.sin(E) - M) / (1 - e * Math.cos(E))
+  const xp = a * (Math.cos(E) - e)
+  const yp = a * Math.sqrt(1 - e * e) * Math.sin(E)
+  const om = (w - O) * RAD, Om = O * RAD
+  const cw = Math.cos(om), sw = Math.sin(om), cO = Math.cos(Om), sO = Math.sin(Om), cI = Math.cos(I), sI = Math.sin(I)
+  return [
+    (cw * cO - sw * sO * cI) * xp + (-sw * cO - cw * sO * cI) * yp,
+    (cw * sO + sw * cO * cI) * xp + (-sw * sO + cw * cO * cI) * yp,
+    sw * sI * xp + cw * sI * yp,
+  ]
+}
+
+export function earthMarsDistanceAU(date) {
+  const T = (julianDay(date) - 2451545.0) / 36525
+  const e = heliocentric(ELEMENTS.earth, T)
+  const m = heliocentric(ELEMENTS.mars, T)
+  return Math.hypot(m[0] - e[0], m[1] - e[1], m[2] - e[2])
+}
+
+export function commsDelay(date) {
+  const au = earthMarsDistanceAU(date)
+  const km = au * AU_KM
+  const oneWayMin = km / C_KM_S / 60
+  return {
+    distanceAU: +au.toFixed(3),
+    distanceMkm: +(km / 1e6).toFixed(1),
+    oneWayMin: +oneWayMin.toFixed(1),
+    roundTripMin: +(oneWayMin * 2).toFixed(1),
+  }
+}
diff --git a/src/lib/evaPlan.js b/src/lib/evaPlan.js
new file mode 100644
index 0000000..7e883a9
--- /dev/null
+++ b/src/lib/evaPlan.js
@@ -0,0 +1,151 @@
+// Turns a planned route into a day-by-day Marswalk (EVA) schedule.
+//
+// All assumptions are explicit constants below so they can be tuned or shown in the UI.
+// Times are local true solar time in Mars hours (a sol has 24 Mars hours, 24h 39m 35s on Earth).
+
+import { MODES } from './routeAnalysis.js'
+import { solarLongitude, seasonName, isDustSeason, daylight, fmtClock, MARS_HOUR_IN_EARTH_HOURS } from './marsTime.js'
+import { commsDelay } from './commsDelay.js'
+
+export const EVA_ASSUMPTIONS = {
+  footKmh: 3.5,            // suited walking pace on level ground
+  daylightMarginH: 0.5,    // keep this long clear of sunrise and of sunset (Earth hours)
+  stopFraction: 0.5,       // a science stop uses half of one sol's EVA budget (matches the "0.5 sol" rule in the UI)
+  suitReserveH: 2,         // emergency consumables: hours of walking back the suit can still support
+  radiationMsvPerSol: 0.64, // MSL RAD surface baseline
+  slopePenaltyDeg: 25,     // speed falls linearly to the minimum factor as slope approaches this
+  minSpeedFactor: 0.25,
+  autonomousDelayMin: 10,  // above this one-way delay, real-time voice support is impractical
+}
+
+const A = EVA_ASSUMPTIONS
+const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v))
+const speedFactor = (slope) => clamp(1 - slope / A.slopePenaltyDeg, A.minSpeedFactor, 1)
+const SOL_DAYS = 1.0274912517
+
+/**
+ * route: output of planRealRoute / planRoute
+ * opts:  { date: Date, travel: 'rover' | 'foot', selectedStopIds: string[] }
+ */
+export function planEva(route, { date = new Date(), travel = 'rover', selectedStopIds = [] } = {}) {
+  if (!route?.points?.length) return null
+  const { points, settings } = route
+  const baseKmh = travel === 'foot' ? A.footKmh : (MODES[route.mode] ?? MODES.fastest).speedKmh
+  const evaHours = settings.evaHoursPerSol
+
+  // time (Earth hours) to travel each leg, slowed by slope
+  const legs = []
+  for (let i = 1; i < points.length; i++) {
+    const len = points[i].km - points[i - 1].km
+    const slope = (points[i].slopeDeg + points[i - 1].slopeDeg) / 2
+    legs.push({ from: points[i - 1].km, to: points[i].km, len, slope, lat: points[i].lat, hours: len / (baseKmh * speedFactor(slope)) })
+  }
+
+  // science stops the crew chose, placed at their km mark
+  const stops = (route.stops || [])
+    .filter((s) => selectedStopIds.includes(s.id))
+    .map((s) => ({ ...s, hours: evaHours * A.stopFraction }))
+    .sort((a, b) => a.km - b.km)
+
+  const warnings = []
+  const sols = []
+  let li = 0, legDone = 0 // progress within current leg (fraction of its hours consumed)
+  let si = 0
+  let stopLeft = 0, curStop = null
+  let solIndex = 0
+
+  while ((li < legs.length || curStop || si < stops.length) && solIndex < 400) {
+    const startKm = li < legs.length ? legs[li].from + legs[li].len * legDone : points[points.length - 1].km
+    const startLat = li < legs.length ? legs[li].lat : points[points.length - 1].lat
+    const when = new Date(date.getTime() + solIndex * SOL_DAYS * 86400000)
+    const ls = solarLongitude(when)
+    const dl = daylight(startLat, ls)
+
+    const usable = Math.max(0, dl.daylightEarthH - 2 * A.daylightMarginH)
+    const night = dl.polarNight || usable < 1
+    const budget = night ? evaHours : Math.min(evaHours, usable)
+    const startClock = night ? 8 : dl.sunrise + A.daylightMarginH / MARS_HOUR_IN_EARTH_HOURS
+
+    let left = budget, used = 0
+    let maxSlope = 0
+    const visited = []
+    const sample = [{ km: startKm }]
+
+    while (left > 1e-6) {
+      if (curStop) {
+        const t = Math.min(left, stopLeft)
+        left -= t; used += t; stopLeft -= t
+        if (stopLeft <= 1e-9) { visited.push(curStop); curStop = null }
+        continue
+      }
+      // enter a stop once we've reached its km mark
+      const here = li < legs.length ? legs[li].from + legs[li].len * legDone : points[points.length - 1].km
+      if (si < stops.length && stops[si].km <= here + 1e-6) {
+        curStop = stops[si++]; stopLeft = curStop.hours
+        continue
+      }
+      if (li >= legs.length) break
+      const leg = legs[li]
+      const remaining = leg.hours * (1 - legDone)
+      // don't overrun the next stop inside this leg
+      let take = Math.min(left, remaining)
+      if (si < stops.length) {
+        const frac = (stops[si].km - (leg.from + leg.len * legDone)) / (leg.len * (1 - legDone) || 1)
+        if (frac > 0 && frac < 1) take = Math.min(take, remaining * frac)
+      }
+      const frac = remaining > 0 ? take / remaining : 1
+      legDone += (1 - legDone) * frac
+      left -= take; used += take
+      maxSlope = Math.max(maxSlope, leg.slope)
+      sample.push({ km: leg.from + leg.len * legDone })
+      if (legDone >= 1 - 1e-9) { li++; legDone = 0 }
+    }
+
+    const endKm = li < legs.length ? legs[li].from + legs[li].len * legDone : points[points.length - 1].km
+    const endClock = startClock + used / MARS_HOUR_IN_EARTH_HOURS
+    const sunsetMargin = night || dl.polarDay ? null : +((dl.sunset - endClock) * MARS_HOUR_IN_EARTH_HOURS).toFixed(1)
+
+    // walk-back: how far the crew is from the nearest camp (start or end of sol) at the worst point
+    const span = endKm - startKm
+    const farthestKm = span / 2
+    const walkBackH = +(farthestKm / A.footKmh).toFixed(1)
+
+    sols.push({
+      sol: solIndex + 1, startKm: +startKm.toFixed(1), endKm: +endKm.toFixed(1), distanceKm: +span.toFixed(1),
+      evaHours: +used.toFixed(1), startClock: fmtClock(startClock), endClock: fmtClock(endClock),
+      startMars: startClock, endMars: endClock,
+      sunrise: dl.polarDay || dl.polarNight ? null : fmtClock(dl.sunrise),
+      sunset: dl.polarDay || dl.polarNight ? null : fmtClock(dl.sunset),
+      sunriseMars: dl.sunrise, sunsetMars: dl.sunset,
+      polarDay: dl.polarDay, night, sunsetMarginH: sunsetMargin, maxSlopeDeg: +maxSlope.toFixed(1),
+      stops: visited.map((s) => s.title), ls: +ls.toFixed(1), walkBackH,
+    })
+    solIndex++
+    if (used < 1e-6 && li >= legs.length && !curStop && si >= stops.length) { sols.pop(); break }
+  }
+
+  // ---- environment and hazards for the whole trip ----
+  const ls0 = solarLongitude(date)
+  const comms = commsDelay(date)
+  const mid = points[Math.floor(points.length / 2)]
+  const dl0 = daylight(points[0].lat, ls0)
+  const totalEva = sols.reduce((s, x) => s + x.evaHours, 0)
+
+  if (sols.some((s) => s.night)) warnings.push({ severity: 'critical', title: 'EVA in darkness', detail: 'At least one sol has little or no daylight at this latitude and season. Choose another date or location.' })
+  if (sols.some((s) => s.sunsetMarginH != null && s.sunsetMarginH < 0)) warnings.push({ severity: 'critical', title: 'Sunset overrun', detail: 'EVA runs past sunset on at least one sol. Shorten EVA hours or split the route.' })
+  if (isDustSeason(ls0) || sols.some((s) => isDustSeason(s.ls))) warnings.push({ severity: 'caution', title: 'Dust-storm season', detail: `Ls ${ls0.toFixed(0)}° is in the Ls 180–360 dust season: expect lower solar power and visibility, and keep a contingency sol.` })
+  if (comms.oneWayMin > A.autonomousDelayMin) warnings.push({ severity: 'info', title: 'Autonomous operations', detail: `One-way radio delay is ${comms.oneWayMin} min (round trip ${comms.roundTripMin} min). Mission control cannot give real-time help; pre-agree decisions for each leg.` })
+  if (travel === 'foot') {
+    const worst = sols.reduce((m, s) => Math.max(m, s.walkBackH), 0)
+    if (worst > A.suitReserveH) warnings.push({ severity: 'critical', title: 'Beyond walk-back range', detail: `Up to ${worst} h from the nearest camp on foot, but the suit reserve covers about ${A.suitReserveH} h. Use shorter EVAs, relay camps, or a pressurised rover.` })
+  }
+
+  return {
+    travel, baseKmh, assumptions: A,
+    startDate: date, ls: +ls0.toFixed(1), season: seasonName(ls0, points[0].lat), dustSeason: isDustSeason(ls0),
+    daylightStart: dl0, daylightMid: daylight(mid.lat, ls0),
+    comms, sols, totalSols: sols.length, totalEvaHours: +totalEva.toFixed(1),
+    radiationMsv: +(sols.length * A.radiationMsvPerSol).toFixed(1),
+    warnings,
+  }
+}
diff --git a/src/lib/evaPlan.test.js b/src/lib/evaPlan.test.js
new file mode 100644
index 0000000..ed2d385
--- /dev/null
+++ b/src/lib/evaPlan.test.js
@@ -0,0 +1,98 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { solarLongitude, daylight, fmtClock, isDustSeason } from './marsTime.js'
+import { commsDelay } from './commsDelay.js'
+import { planEva } from './evaPlan.js'
+import { evaPlanText, evaPlanJson } from './exportRoute.js'
+import { planRealRoute, shortcutPath } from './realRoute.js'
+
+const d = (s) => new Date(`${s}T00:00:00Z`)
+const NILI = { id: 'nili', name: 'Nili Fossae', lat: 21.0, lon: 74.5 }
+const JEZERO = { id: 'jezero', name: 'Jezero Crater', lat: 18.435, lon: 77.527 }
+const settings = (o = {}) => ({ mode: 'fastest', maxSlopeDeg: 15, avoidRough: true, showScience: true, evaHoursPerSol: 6, ...o })
+const flat = { prepareTerrain: async () => ({ heightAt: () => -2, source: { real: true, name: 'test' } }) }
+
+test('solar longitude is ~0 at known Mars year starts', () => {
+  for (const day of ['2021-02-07', '2022-12-26', '2024-11-12', '2026-09-30']) {
+    const ls = solarLongitude(d(day))
+    assert.ok(ls > 357 || ls < 3, `${day}: ${ls}`)
+  }
+})
+
+test('Earth-Mars distance matches known oppositions and conjunction', () => {
+  assert.ok(Math.abs(commsDelay(d('2025-01-16')).distanceAU - 0.64) < 0.03)
+  assert.ok(Math.abs(commsDelay(d('2027-02-19')).distanceAU - 0.68) < 0.03)
+  const c = commsDelay(d('2026-01-09'))
+  assert.ok(c.oneWayMin > 17 && c.oneWayMin < 24, `conjunction delay ${c.oneWayMin}`)
+})
+
+test('daylight: equator is 12 Mars hours; high north in summer is polar day', () => {
+  assert.ok(Math.abs(daylight(0, 90).daylightMarsH - 12) < 0.01)
+  assert.equal(daylight(75, 90).polarDay, true)
+  assert.equal(daylight(75, 270).polarNight, true)
+  assert.equal(fmtClock(8.5), '08:30')
+  assert.equal(isDustSeason(251), true)
+})
+
+test('straightening keeps a flat route close to the great circle', async () => {
+  const r = await planRealRoute(NILI, JEZERO, settings(), flat)
+  assert.ok(r.distanceKm <= 232, `${r.distanceKm}`) // great circle is ~227 km
+})
+
+test('straightening never cuts through terrain above the slope limit', () => {
+  const g = { gw: 20, gh: 5, dy: 1, dxRow: new Float32Array(5).fill(1), heights: new Float32Array(100) }
+  for (let y = 0; y < 5; y++) g.heights[y * 20 + 10] = 50 // tall ridge
+  const nodes = Array.from({ length: 20 }, (_, i) => ({ fx: i, fy: 2 }))
+  // path along the row crosses the ridge; every shortcut over it must be rejected, so all nodes that
+  // touch the ridge are kept
+  const out = shortcutPath(g, nodes, { maxSlope: 15, slopeWeight: 1, bonus: null })
+  assert.ok(out.length >= 2)
+})
+
+async function sample(over = {}, evaOpts = {}) {
+  const pois = [{ id: 'near', name: 'Near site', lat: 19.7, lon: 76.05, note: 'on the way', source: 'MRO CRISM' }]
+  const route = await planRealRoute(NILI, JEZERO, settings(over), { ...flat, pois })
+  return { route, plan: planEva(route, { date: d('2026-10-22'), selectedStopIds: ['poi-near'], ...evaOpts }) }
+}
+
+test('schedule covers the whole route, sol by sol, inside daylight', async () => {
+  const { route, plan } = await sample()
+  assert.equal(plan.sols[0].startKm, 0)
+  assert.ok(Math.abs(plan.sols.at(-1).endKm - route.distanceKm) < 1)
+  for (let i = 1; i < plan.sols.length; i++) assert.ok(Math.abs(plan.sols[i].startKm - plan.sols[i - 1].endKm) < 0.2)
+  assert.ok(plan.sols.every((s) => s.evaHours <= 6.001 && s.sunsetMarginH > 0))
+})
+
+test('a selected science stop adds EVA time and shows up in the schedule', async () => {
+  const { route, plan } = await sample()
+  const without = planEva(route, { date: d('2026-10-22'), selectedStopIds: [] })
+  assert.ok(plan.totalEvaHours > without.totalEvaHours + 2.5)
+  assert.ok(plan.sols.some((s) => s.stops.includes('Near site')))
+})
+
+test('walking is slower than driving and triggers a walk-back warning', async () => {
+  const { route } = await sample()
+  const rover = planEva(route, { date: d('2026-10-22'), travel: 'rover' })
+  const foot = planEva(route, { date: d('2026-10-22'), travel: 'foot' })
+  assert.ok(foot.totalSols > rover.totalSols)
+  assert.ok(foot.warnings.some((w) => w.title === 'Beyond walk-back range'))
+  assert.ok(!rover.warnings.some((w) => w.title === 'Beyond walk-back range'))
+})
+
+test('dust season and polar night are flagged', async () => {
+  const { route } = await sample()
+  const dusty = planEva(route, { date: d('2027-11-15') }) // Ls ~ 220: inside the dust season
+  assert.ok(isDustSeason(dusty.ls) && dusty.warnings.some((w) => w.title === 'Dust-storm season'))
+  const polar = { ...route, points: route.points.map((p) => ({ ...p, lat: 80 })) }
+  const night = planEva(polar, { date: d('2026-12-01') })
+  assert.ok(night.warnings.some((w) => w.title === 'EVA in darkness') || night.sols.every((s) => !s.night))
+})
+
+test('mission card text and JSON export are well formed', async () => {
+  const { route, plan } = await sample()
+  const txt = evaPlanText(route, plan)
+  assert.match(txt, /REDMAP EVA MISSION CARD/)
+  assert.match(txt, /Nili Fossae -> Jezero Crater/)
+  const json = JSON.parse(evaPlanJson(route, plan))
+  assert.equal(json.eva.sols.length, plan.sols.length)
+})
diff --git a/src/lib/exportRoute.js b/src/lib/exportRoute.js
index e69de29..eff1ca7 100644
--- a/src/lib/exportRoute.js
+++ b/src/lib/exportRoute.js
@@ -0,0 +1,53 @@
+// Export a planned route + EVA schedule as a printable mission card (text) or JSON.
+
+const pad = (s, n) => String(s).padEnd(n)
+
+export function evaPlanText(route, plan) {
+  if (!route || !plan) return ''
+  const L = []
+  L.push('REDMAP EVA MISSION CARD')
+  L.push('='.repeat(60))
+  L.push(`Route:      ${route.start.name} -> ${route.end.name}`)
+  L.push(`Mode:       ${route.settings.mode} / ${plan.travel === 'foot' ? 'on foot' : 'pressurised rover'}`)
+  L.push(`Distance:   ${route.distanceKm} km   Sols: ${plan.totalSols}   EVA hours: ${plan.totalEvaHours}`)
+  L.push(`Max slope:  ${route.maxSlopeDeg.toFixed(0)} deg   Elevation gain: +${route.elevationGainKm} km`)
+  L.push(`Date:       ${plan.startDate.toISOString().slice(0, 10)}   Ls ${plan.ls} deg (${plan.season})`)
+  L.push(`Comms:      one-way ${plan.comms.oneWayMin} min, round trip ${plan.comms.roundTripMin} min (${plan.comms.distanceAU} AU)`)
+  L.push(`Radiation:  ~${plan.radiationMsv} mSv (0.64 mSv/sol baseline)`)
+  L.push(`Terrain:    ${route.dataSource?.real ? route.dataSource.name : 'SIMULATED (NASA elevation unavailable)'}`)
+  L.push('')
+  L.push(`${pad('Sol', 5)}${pad('Km', 14)}${pad('EVA window (LTST)', 20)}${pad('Hours', 7)}Notes`)
+  L.push('-'.repeat(60))
+  for (const s of plan.sols) {
+    const notes = []
+    if (s.sunset) notes.push(`sunset ${s.sunset}`)
+    if (s.stops.length) notes.push(`stops: ${s.stops.join(', ')}`)
+    if (s.night) notes.push('LOW LIGHT')
+    L.push(`${pad(s.sol, 5)}${pad(`${s.startKm}-${s.endKm}`, 14)}${pad(`${s.startClock}-${s.endClock}`, 20)}${pad(s.evaHours, 7)}${notes.join('; ')}`)
+  }
+  const all = [...route.warnings, ...plan.warnings]
+  if (all.length) {
+    L.push('', 'HAZARDS AND CONDITIONS')
+    for (const w of all) L.push(`- [${w.severity.toUpperCase()}] ${w.title}: ${w.detail}`)
+  }
+  L.push('', 'Assumptions: ' + Object.entries(plan.assumptions).map(([k, v]) => `${k}=${v}`).join(', '))
+  L.push('Data: NASA MGS MOLA elevation, MSL RAD radiation baseline; temperatures are estimates.')
+  return L.join('\n')
+}
+
+export function evaPlanJson(route, plan) {
+  return JSON.stringify({
+    route: { start: route.start.name, end: route.end.name, distanceKm: route.distanceKm, mode: route.settings.mode, dataSource: route.dataSource, points: route.points },
+    eva: { ...plan, startDate: plan.startDate.toISOString() },
+  }, null, 2)
+}
+
+/** Browser download helper (no-op outside the browser). */
+export function downloadText(filename, text, type = 'text/plain') {
+  if (typeof document === 'undefined') return
+  const url = URL.createObjectURL(new Blob([text], { type }))
+  const a = document.createElement('a')
+  a.href = url; a.download = filename
+  document.body.appendChild(a); a.click(); a.remove()
+  setTimeout(() => URL.revokeObjectURL(url), 1000)
+}
