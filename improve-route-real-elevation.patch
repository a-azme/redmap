--- /dev/null
+++ b/src/lib/routeAnalysis.js
@@ -0,0 +1,110 @@
+// Pure route maths shared by the real (DEM based) planner and the legacy
+// simulated planner. No DOM, no JSON imports, so it can run under `node --test`.
+
+export const MARS_RADIUS_KM = 3389.5
+
+export const MODES = {
+  fastest:    { label: 'Fastest Route', detour: 1.08, roughness: 1.0,  speedKmh: 10 },
+  safest:     { label: 'Safest Route',  detour: 1.25, roughness: 0.55, speedKmh: 8  },
+  scientific: { label: 'Most Science',  detour: 1.18, roughness: 0.8,  speedKmh: 8  },
+}
+
+const rad = (d) => (d * Math.PI) / 180
+
+export function haversineKm(a, b) {
+  const dLat = rad(b.lat - a.lat)
+  const dLon = rad(b.lon - a.lon)
+  const h =
+    Math.sin(dLat / 2) ** 2 +
+    Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLon / 2) ** 2
+  return 2 * MARS_RADIUS_KM * Math.asin(Math.min(1, Math.sqrt(h)))
+}
+
+// Rough surface temperature estimate (deg C). Colder towards the poles and with altitude.
+export const estimateTempC = (latDeg, elevKm) =>
+  Math.round(-45 - Math.abs(latDeg) * 0.6 - elevKm * 1.5)
+
+/**
+ * Turns a list of route points into the full route object the UI consumes
+ * (stats, hazard warnings, risk score).
+ *
+ * points: [{ km, lat, lon, elevKm, terrain, slopeDeg, tempC }]
+ * stops:  [{ id, title, source, detail, km, lat, lon, elevKm }]
+ * dataSource: { real: boolean, name?, resolutionKm?, note? }
+ */
+export function finalizeRoute({ start, end, settings, points, distanceKm, stops = [], dataSource }) {
+  const mode = MODES[settings.mode] ?? MODES.fastest
+
+  let gain = 0, loss = 0
+  for (let i = 1; i < points.length; i++) {
+    const d = points[i].elevKm - points[i - 1].elevKm
+    if (d > 0) gain += d; else loss -= d
+  }
+  const avgSlopeDeg = +(points.reduce((s, p) => s + p.slopeDeg, 0) / points.length).toFixed(1)
+  const maxSlopeDeg = Math.max(...points.map((p) => p.slopeDeg))
+  const minTempC = Math.min(...points.map((p) => p.tempC))
+
+  const kmPerSol = mode.speedKmh * settings.evaHoursPerSol
+  const sols = Math.max(1, Math.ceil(distanceKm / kmPerSol))
+  // Surface radiation measured by Curiosity's RAD is roughly 0.64 mSv per sol
+  const radiationMsv = +(sols * 0.64).toFixed(1)
+
+  // ---- warnings: merge consecutive bad points into one warning ----
+  const warnings = []
+  const addRuns = (test, make) => {
+    let s = null
+    points.forEach((p, i) => {
+      const hit = test(p)
+      if (hit && s === null) s = i
+      if ((!hit || i === points.length - 1) && s !== null) {
+        const e = hit ? i : i - 1
+        warnings.push({ ...make(points.slice(s, e + 1)), fromKm: points[s].km, toKm: points[e].km })
+        s = null
+      }
+    })
+  }
+  addRuns((p) => p.slopeDeg > settings.maxSlopeDeg, (seg) => ({
+    severity: 'critical', title: 'Steep Slope',
+    detail: `Up to ${Math.max(...seg.map((p) => p.slopeDeg)).toFixed(0)}° – exceeds your ${settings.maxSlopeDeg}° limit. Find a detour.`,
+  }))
+  addRuns((p) => p.terrain === 'Rough / boulders', () => ({
+    severity: 'caution', title: 'Rough Terrain', detail: 'Boulder field – reduce speed, risk to wheels and suit abrasion.',
+  }))
+  addRuns((p) => p.terrain === 'Rugged', () => ({
+    severity: 'caution', title: 'Rugged Terrain',
+    detail: 'Steep, broken ground in the elevation model – reduce speed and scout on foot.',
+  }))
+  addRuns((p) => p.terrain === 'Crater rim', () => ({
+    severity: 'caution', title: 'Crater Rim', detail: 'Steep, loose material on the rim. Scout on foot first.',
+  }))
+  if (minTempC < -75) warnings.push({ severity: 'caution', title: 'Extreme Cold', detail: `Estimated down to ${minTempC}°C – check suit heating margins.`, fromKm: 0, toKm: distanceKm })
+  if (sols > 30) warnings.push({ severity: 'caution', title: 'Dust-Storm Exposure', detail: `${sols} sols on the surface – likely to overlap a regional dust storm (solar power and visibility drop).`, fromKm: 0, toKm: distanceKm })
+  if (Math.max(Math.abs(start.lat), Math.abs(end.lat)) > 60) warnings.push({ severity: 'info', title: 'Comms Gaps', detail: 'High latitude – fewer orbiter relay passes.', fromKm: 0, toKm: distanceKm })
+
+  if (dataSource && !dataSource.real) {
+    warnings.push({ severity: 'info', title: 'Simulated terrain', detail: 'NASA elevation data could not be loaded, so slopes and terrain on this route are illustrative only.', fromKm: 0, toKm: distanceKm })
+  } else if (dataSource?.resolutionKm > 1.5) {
+    warnings.push({ severity: 'info', title: 'Coarse terrain model', detail: `Elevation sampled every ~${dataSource.resolutionKm.toFixed(1)} km. Slopes and boulders smaller than that are not resolved – check HiRISE/CTX imagery before committing to a leg.`, fromKm: 0, toKm: distanceKm })
+  }
+
+  warnings.sort((a, b) => a.fromKm - b.fromKm)
+  warnings.forEach((w, i) => {
+    w.id = `w${i}`
+    const p = points.reduce((a, b) => (Math.abs(b.km - w.fromKm) < Math.abs(a.km - w.fromKm) ? b : a))
+    w.lat = p.lat; w.lon = p.lon
+  })
+
+  // ---- risk score 0–100 ----
+  const steepShare = points.filter((p) => p.slopeDeg > settings.maxSlopeDeg).length / points.length
+  const critical = warnings.filter((w) => w.severity === 'critical').length
+  const risk = Math.min(100, Math.round(steepShare * 120 + critical * 8 + Math.min(sols, 60) * 0.5 + (minTempC < -75 ? 8 : 0)))
+
+  return {
+    start, end, settings, mode: settings.mode, distanceKm, sols,
+    elevationGainKm: +gain.toFixed(2), elevationLossKm: +loss.toFixed(2),
+    avgSlopeDeg, maxSlopeDeg, minTempC, radiationMsv, risk,
+    riskLabel: risk < 25 ? 'Low' : risk < 55 ? 'Moderate' : 'High',
+    points, path: points.map((p) => ({ lat: p.lat, lon: p.lon })), warnings, stops,
+    dataSource: dataSource ?? { real: false },
+  }
+}
diff --git a/src/services/marsElevation.js b/src/services/marsElevation.js
new file mode 100644
index 0000000..946f365
--- /dev/null
+++ b/src/services/marsElevation.js
@@ -0,0 +1,205 @@
+// Real Mars elevation for the route planner, sampled from NASA Mars Trek's
+// MGS MOLA DEM tiles (the same WMTS server the map layers use).
+//
+// Tiles are 8-bit images, so we do not trust any assumed grey-to-metres scale.
+// Instead we sample the tiles at well-known landing-site / landform heights,
+// fit  elevation = a * grey + b,  and only use the data if the fit is good.
+// If the tiles cannot be loaded or the fit fails, callers fall back to the
+// simulated planner and the UI says so.
+
+const TREK = 'https://trek.nasa.gov/tiles/Mars/EQ'
+const DEFAULT_PRODUCT = 'Mars_MGS_MOLA_DEM_mosaic_global_463m'
+
+// Override the tile template without touching code: VITE_MARS_DEM_URL in .env
+// e.g. https://trek.nasa.gov/tiles/Mars/EQ/<product>/1.0.0/default/default028mm/{z}/{y}/{x}.{ext}
+const ENV_URL = typeof import.meta !== 'undefined' ? import.meta.env?.VITE_MARS_DEM_URL : undefined
+export const DEM_SOURCE = {
+  name: 'NASA MGS MOLA elevation (Mars Trek, 463 m)',
+  url: ENV_URL || `${TREK}/${DEFAULT_PRODUCT}/1.0.0/default/default028mm/{z}/{y}/{x}.{ext}`,
+  maxZoom: 6,
+}
+
+// Km per degree at the Mars surface, and the size of one tile pixel at zoom 0 (km)
+const KM_PER_DEG = (3389.5 * Math.PI) / 180
+const PIXEL_KM_Z0 = (180 / 256) * KM_PER_DEG
+const MAX_TILES = 48
+
+// Reference heights above the MOLA datum (km). lon is degrees east.
+export const ANCHORS = [
+  { name: 'Hellas Planitia floor', lat: -42.4, lon: 70.5, km: -8.2 },
+  { name: 'Olympus Mons summit', lat: 18.65, lon: 226.2, km: 21.2 },
+  { name: 'Jezero Crater / Perseverance', lat: 18.44, lon: 77.45, km: -2.6 },
+  { name: 'Gale Crater / Curiosity', lat: -4.59, lon: 137.44, km: -4.4 },
+  { name: 'Meridiani / Opportunity', lat: -1.95, lon: 354.47, km: -1.4 },
+  { name: 'Gusev / Spirit', lat: -14.57, lon: 175.47, km: -1.9 },
+  { name: 'Elysium Planitia / InSight', lat: 4.5, lon: 135.6, km: -2.6 },
+  { name: 'Chryse / Viking 1', lat: 22.27, lon: 312.05, km: -3.6 },
+  { name: 'Utopia / Viking 2', lat: 47.67, lon: 225.71, km: -4.5 },
+  { name: 'Ares Vallis / Pathfinder', lat: 19.13, lon: 326.78, km: -2.7 },
+  { name: 'Vastitas Borealis / Phoenix', lat: 68.22, lon: 234.3, km: -4.1 },
+  { name: 'Isidis Planitia', lat: 12.9, lon: 87.0, km: -3.8 },
+]
+const CAL_ZOOM = 4
+const CAL_MIN_R2 = 0.85
+const CAL_MAX_RMSE_KM = 1.5
+
+const wrapLon180 = (l) => ((((l + 180) % 360) + 360) % 360) - 180
+const fill = (tpl, ext, z, x, y) =>
+  tpl.replace('{ext}', ext).replace('{z}', z).replace('{y}', y).replace('{x}', x)
+
+/** Browser tile loader: resolves { gray, alpha, colorful } or null when the tile is missing. */
+export function browserTileLoader(template) {
+  const loadImg = (url) =>
+    new Promise((resolve) => {
+      const img = new Image()
+      img.crossOrigin = 'anonymous'
+      img.onload = () => resolve(img)
+      img.onerror = () => resolve(null)
+      img.src = url
+    })
+  return async (z, x, y) => {
+    for (const ext of ['png', 'jpg']) {
+      const img = await loadImg(fill(template, ext, z, x, y))
+      if (!img) continue
+      const c = document.createElement('canvas')
+      c.width = 256; c.height = 256
+      const ctx = c.getContext('2d', { willReadFrequently: true })
+      ctx.drawImage(img, 0, 0, 256, 256)
+      const d = ctx.getImageData(0, 0, 256, 256).data
+      const gray = new Uint8Array(65536), alpha = new Uint8Array(65536)
+      let chroma = 0
+      for (let i = 0; i < 65536; i++) {
+        const r = d[i * 4], g = d[i * 4 + 1], b = d[i * 4 + 2]
+        gray[i] = r; alpha[i] = d[i * 4 + 3]
+        chroma += Math.abs(r - g) + Math.abs(g - b)
+      }
+      return { gray, alpha, colorful: chroma / 65536 > 6 }
+    }
+    return null
+  }
+}
+
+class Mosaic {
+  constructor(z, loadTile) {
+    this.z = z
+    this.loadTile = loadTile
+    this.tiles = new Map()
+    this.cols = 2 ** (z + 1)
+    this.rows = 2 ** z
+  }
+  key(x, y) { return `${x}/${y}` }
+  tileFor(lat, lon) {
+    const px = ((wrapLon180(lon) + 180) / 360) * this.cols * 256
+    const py = ((90 - lat) / 180) * this.rows * 256
+    return { x: Math.min(this.cols - 1, Math.floor(px / 256)), y: Math.min(this.rows - 1, Math.max(0, Math.floor(py / 256))) }
+  }
+  async ensure(list) {
+    const todo = list.filter((t) => !this.tiles.has(this.key(t.x, t.y)))
+    await Promise.all(todo.map(async (t) => {
+      this.tiles.set(this.key(t.x, t.y), (await this.loadTile(this.z, t.x, t.y)) || null)
+    }))
+  }
+  px(ix, iy) {
+    const x = ((ix % (this.cols * 256)) + this.cols * 256) % (this.cols * 256)
+    const y = Math.min(this.rows * 256 - 1, Math.max(0, iy))
+    const t = this.tiles.get(this.key(Math.floor(x / 256), Math.floor(y / 256)))
+    if (!t) return NaN
+    const i = (y % 256) * 256 + (x % 256)
+    return t.alpha[i] < 128 ? NaN : t.gray[i]
+  }
+  /** Bilinear grey value (0-255) at lat/lon, NaN where there is no data. */
+  gray(lat, lon) {
+    const fx = ((wrapLon180(lon) + 180) / 360) * this.cols * 256 - 0.5
+    const fy = ((90 - lat) / 180) * this.rows * 256 - 0.5
+    const x0 = Math.floor(fx), y0 = Math.floor(fy)
+    const u = fx - x0, v = fy - y0
+    const a = this.px(x0, y0), b = this.px(x0 + 1, y0), c = this.px(x0, y0 + 1), d = this.px(x0 + 1, y0 + 1)
+    return a * (1 - u) * (1 - v) + b * u * (1 - v) + c * (1 - u) * v + d * u * v
+  }
+  anyColorful() {
+    for (const t of this.tiles.values()) if (t?.colorful) return true
+    return false
+  }
+}
+
+function fitLine(xs, ys) {
+  const n = xs.length
+  const mx = xs.reduce((s, v) => s + v, 0) / n
+  const my = ys.reduce((s, v) => s + v, 0) / n
+  let sxx = 0, sxy = 0, syy = 0
+  for (let i = 0; i < n; i++) {
+    sxx += (xs[i] - mx) ** 2; sxy += (xs[i] - mx) * (ys[i] - my); syy += (ys[i] - my) ** 2
+  }
+  const a = sxy / sxx
+  const b = my - a * mx
+  let sse = 0
+  for (let i = 0; i < n; i++) sse += (ys[i] - (a * xs[i] + b)) ** 2
+  return { a, b, r2: syy ? 1 - sse / syy : 0, rmse: Math.sqrt(sse / n) }
+}
+
+export function createMarsTerrain({ loadTile, anchors = ANCHORS, source = DEM_SOURCE } = {}) {
+  let calibration = null // cached { ok, a, b, r2, rmse, reason, at }
+
+  async function calibrate() {
+    if (calibration && (calibration.ok || Date.now() - calibration.at < 60_000)) return calibration
+    const fail = (reason) => (calibration = { ok: false, reason, at: Date.now() })
+    const m = new Mosaic(CAL_ZOOM, loadTile)
+    await m.ensure(anchors.map((p) => m.tileFor(p.lat, p.lon)))
+    if (m.anyColorful()) return fail('DEM tiles are colour images, not grey-scale elevation')
+    const xs = [], ys = []
+    for (const p of anchors) {
+      const g = m.gray(p.lat, p.lon)
+      if (Number.isFinite(g)) { xs.push(g); ys.push(p.km) }
+    }
+    if (xs.length < 6) return fail(`only ${xs.length} reference sites could be sampled`)
+    const f = fitLine(xs, ys)
+    if (!(f.a > 0) || f.r2 < CAL_MIN_R2 || f.rmse > CAL_MAX_RMSE_KM) {
+      return fail(`DEM did not match known site heights (R²=${f.r2.toFixed(2)}, RMSE=${f.rmse.toFixed(2)} km)`)
+    }
+    console.info(`[RedMap] MOLA DEM calibrated: elev = ${f.a.toFixed(4)}*grey + ${f.b.toFixed(2)} km (R²=${f.r2.toFixed(3)}, RMSE=${f.rmse.toFixed(2)} km, ${xs.length} sites)`)
+    return (calibration = { ok: true, ...f, at: Date.now() })
+  }
+
+  /** Called by the route planner with { bounds, cellKm }. Throws if real data is unavailable. */
+  async function prepareTerrain({ bounds, cellKm }) {
+    const cal = await calibrate()
+    if (!cal.ok) throw new Error(cal.reason)
+
+    // coarsest zoom whose pixels are no bigger than a grid cell, capped at the DEM's native resolution
+    let z = Math.min(source.maxZoom, Math.max(0, Math.ceil(Math.log2(PIXEL_KM_Z0 / cellKm))))
+    const m = () => new Mosaic(z, loadTile)
+    let mosaic = m()
+    let list
+    for (;;) {
+      mosaic = m()
+      const seen = new Map()
+      const step = 180 / mosaic.rows / 2 // half a tile in degrees
+      for (let lat = bounds.latMin; lat <= bounds.latMax + step; lat += step) {
+        for (let lon = bounds.lonMin; lon <= bounds.lonMax + step; lon += step) {
+          const t = mosaic.tileFor(Math.min(bounds.latMax, lat), Math.min(bounds.lonMax, lon))
+          seen.set(mosaic.key(t.x, t.y), t)
+        }
+      }
+      list = [...seen.values()]
+      if (list.length <= MAX_TILES || z === 0) break
+      z--
+    }
+    await mosaic.ensure(list)
+    const missing = list.filter((t) => !mosaic.tiles.get(mosaic.key(t.x, t.y))).length
+    if (missing / list.length > 0.2) throw new Error(`${missing} of ${list.length} elevation tiles failed to load`)
+
+    return {
+      heightAt: (lat, lon) => cal.a * mosaic.gray(lat, lon) + cal.b,
+      source: {
+        real: true,
+        name: source.name,
+        zoom: z,
+        calibration: { r2: +cal.r2.toFixed(3), rmseKm: +cal.rmse.toFixed(2) },
+      },
+    }
+  }
+
+  return { prepareTerrain, calibrate }
+}
+
+export const marsTerrain = createMarsTerrain({ loadTile: browserTileLoader(DEM_SOURCE.url) })
diff --git a/src/services/marsElevation.test.js b/src/services/marsElevation.test.js
new file mode 100644
index 0000000..d302aaa
--- /dev/null
+++ b/src/services/marsElevation.test.js
@@ -0,0 +1,93 @@
+// Tests the NASA tile sampler against a fake tile server (no network needed).
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { createMarsTerrain, ANCHORS } from './marsElevation.js'
+import { planRealRoute } from '../lib/realRoute.js'
+import { haversineKm } from '../lib/routeAnalysis.js'
+
+// Smooth fake planet: heights blend towards the nearest anchor's known height.
+const trueElev = (lat, lon) => {
+  let num = 0, den = 1e-9
+  for (const a of ANCHORS) {
+    const d = haversineKm({ lat, lon }, a)
+    const w = Math.exp(-(d * d) / (2 * 400 * 400))
+    num += w * a.km; den += w
+  }
+  return den > 1e-6 ? num / den : -2
+}
+// 8-bit encoding with an arbitrary stretch the code must discover on its own
+const encode = (km) => Math.max(0, Math.min(255, Math.round(((km + 9.5) / 32) * 255)))
+
+function fakeServer({ colorful = false, missing = () => false } = {}) {
+  const calls = { n: 0 }
+  const loadTile = async (z, x, y) => {
+    calls.n++
+    if (missing(z, x, y)) return null
+    const cols = 2 ** (z + 1), rows = 2 ** z
+    const gray = new Uint8Array(65536), alpha = new Uint8Array(65536).fill(255)
+    for (let py = 0; py < 256; py++) {
+      const lat = 90 - ((y * 256 + py + 0.5) / (rows * 256)) * 180
+      for (let px = 0; px < 256; px++) {
+        const lon = ((x * 256 + px + 0.5) / (cols * 256)) * 360 // 0..360 east
+        gray[py * 256 + px] = encode(trueElev(lat, lon))
+      }
+    }
+    return { gray, alpha, colorful }
+  }
+  return { loadTile, calls }
+}
+
+// The fake above indexes longitude 0..360; real tiles start at -180, so shift columns by half the world.
+function fakeServerStd(opts) {
+  const base = fakeServer(opts)
+  const loadTile = async (z, x, y) => {
+    const cols = 2 ** (z + 1)
+    return base.loadTile(z, (x + cols / 2) % cols, y)
+  }
+  return { loadTile, calls: base.calls }
+}
+
+test('calibrates against known site heights and recovers elevations', async () => {
+  const srv = fakeServerStd()
+  const t = createMarsTerrain({ loadTile: srv.loadTile })
+  const cal = await t.calibrate()
+  assert.equal(cal.ok, true, cal.reason)
+  assert.ok(cal.r2 > 0.95)
+  const terrain = await t.prepareTerrain({
+    bounds: { lonMin: 74, lonMax: 81, latMin: 16, latMax: 23 }, cellKm: 1,
+  })
+  assert.equal(terrain.source.real, true)
+  const h = terrain.heightAt(18.44, 77.45)
+  assert.ok(Math.abs(h - trueElev(18.44, 77.45)) < 0.4, `height ${h}`)
+})
+
+test('plans a full route on the fake NASA tiles', async () => {
+  const t = createMarsTerrain({ loadTile: fakeServerStd().loadTile })
+  const nili = { id: 'nili', name: 'Nili', lat: 21.0, lon: 74.5 }
+  const jez = { id: 'jez', name: 'Jezero', lat: 18.435, lon: 77.527 }
+  const r = await planRealRoute(nili, jez, { mode: 'fastest', maxSlopeDeg: 15, avoidRough: true, showScience: false, evaHoursPerSol: 6 }, { prepareTerrain: t.prepareTerrain })
+  assert.equal(r.dataSource.real, true)
+  assert.ok(r.points.every((p) => Number.isFinite(p.elevKm)))
+})
+
+test('rejects colour (non-elevation) tiles', async () => {
+  const t = createMarsTerrain({ loadTile: fakeServerStd({ colorful: true }).loadTile })
+  const cal = await t.calibrate()
+  assert.equal(cal.ok, false)
+  await assert.rejects(t.prepareTerrain({ bounds: { lonMin: 74, lonMax: 81, latMin: 16, latMax: 23 }, cellKm: 1 }))
+})
+
+test('rejects tiles that do not match known heights', async () => {
+  const noise = async () => {
+    const gray = new Uint8Array(65536).map(() => Math.floor(Math.random() * 256))
+    return { gray, alpha: new Uint8Array(65536).fill(255), colorful: false }
+  }
+  const cal = await createMarsTerrain({ loadTile: noise }).calibrate()
+  assert.equal(cal.ok, false)
+})
+
+test('fails cleanly when the tile server is unreachable', async () => {
+  const t = createMarsTerrain({ loadTile: async () => null })
+  const cal = await t.calibrate()
+  assert.equal(cal.ok, false)
+})
diff --git a/src/services/routePlanner.js b/src/services/routePlanner.js
new file mode 100644
index 0000000..1a05429
--- /dev/null
+++ b/src/services/routePlanner.js
@@ -0,0 +1,29 @@
+// Entry point used by the Route Planner UI.
+//
+// 1. Try to plan on real NASA MOLA elevation (A* over a DEM grid).
+// 2. If the elevation tiles cannot be loaded, fall back to the old simulated
+//    planner and flag the route (route.dataSource.real === false) so the UI is honest.
+// Genuine planning outcomes (no passable route, points too close) are thrown, not hidden.
+
+import sciencePOIs from '../data/sciencePOIs.json'
+import { planRealRoute, RouteError } from '../lib/realRoute.js'
+import { marsTerrain } from './marsElevation.js'
+import { planRoute as planSimulated } from '../components/route/routeUtils'
+
+const PLANNING_ERRORS = new Set(['blocked', 'too_close'])
+
+export async function planRouteAsync(start, end, settings) {
+  if (!start || !end || start.id === end.id) return null
+  try {
+    return await planRealRoute(start, end, settings, {
+      prepareTerrain: marsTerrain.prepareTerrain,
+      pois: sciencePOIs,
+    })
+  } catch (err) {
+    if (err instanceof RouteError && PLANNING_ERRORS.has(err.code)) throw err
+    console.warn('[RedMap] Real elevation unavailable, using simulated route:', err.message)
+    const route = planSimulated(start, end, settings)
+    if (route) route.dataSource = { real: false, reason: err.message }
+    return route
+  }
+}
