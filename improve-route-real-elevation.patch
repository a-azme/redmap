index 0000000..125df77
--- /dev/null
+++ b/src/lib/realRoute.js
@@ -0,0 +1,258 @@
+// Route planning on a real elevation grid.
+//
+// Pure logic: the caller supplies `prepareTerrain(spec)` which returns
+// `{ heightAt(lat, lon) -> km, source }`. In the app that is the NASA MOLA
+// sampler (services/marsElevation.js); in tests it is a synthetic surface.
+
+import { ROUTE_MODES, POI_NEAR_KM } from '../constants/config.js'
+import { findPath } from './pathfinding.js'
+import { haversineKm, finalizeRoute, estimateTempC, MARS_RADIUS_KM } from './routeAnalysis.js'
+
+const RAD = Math.PI / 180
+const KM_PER_DEG = MARS_RADIUS_KM * RAD
+const wrapLon = (d) => ((((d + 180) % 360) + 360) % 360) - 180
+const to360 = (l) => ((l % 360) + 360) % 360
+const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v))
+
+export class RouteError extends Error {
+  constructor(code, message) { super(message); this.code = code }
+}
+
+/** Bounding box + grid size for a start/end pair. Longitudes are unwrapped around lonMid. */
+export function gridSpec(start, end, { maxCells = 220, minCellKm = 0.5 } = {}) {
+  const dLon = wrapLon(end.lon - start.lon)
+  const lonMid = start.lon + dLon / 2
+  const latMid = (start.lat + end.lat) / 2
+  const cosM = Math.max(0.2, Math.cos(latMid * RAD))
+  const spanLat = Math.abs(end.lat - start.lat)
+  const spanLon = Math.abs(dLon)
+  const pad = Math.max(0.3 * Math.max(spanLat, spanLon * cosM), 0.5) // degrees
+
+  const latMin = Math.max(-89, Math.min(start.lat, end.lat) - pad)
+  const latMax = Math.min(89, Math.max(start.lat, end.lat) + pad)
+  const lonHalf = spanLon / 2 + pad / cosM
+  if (lonHalf * 2 > 350) throw new RouteError('too_far', 'These two locations are too far apart to plan on one grid.')
+  const lonMin = lonMid - lonHalf
+  const lonMax = lonMid + lonHalf
+
+  const widthKm = (lonMax - lonMin) * KM_PER_DEG * cosM
+  const heightKm = (latMax - latMin) * KM_PER_DEG
+  const cellKm = Math.max(minCellKm, Math.max(widthKm, heightKm) / maxCells)
+  const gw = Math.max(8, Math.round(widthKm / cellKm) + 1)
+  const gh = Math.max(8, Math.round(heightKm / cellKm) + 1)
+  return { bounds: { lonMin, lonMax, latMin, latMax }, lonMid, gw, gh, cellKm }
+}
+
+function blur3(src, gw, gh) {
+  const out = new Float32Array(src.length)
+  for (let y = 0; y < gh; y++) {
+    for (let x = 0; x < gw; x++) {
+      let s = 0, n = 0
+      for (let oy = -1; oy <= 1; oy++) {
+        const yy = y + oy
+        if (yy < 0 || yy >= gh) continue
+        for (let ox = -1; ox <= 1; ox++) {
+          const xx = x + ox
+          if (xx < 0 || xx >= gw) continue
+          s += src[yy * gw + xx]; n++
+        }
+      }
+      out[y * gw + x] = s / n
+    }
+  }
+  return out
+}
+
+export function buildGrid(spec, heightAt) {
+  const { bounds: b, gw, gh } = spec
+  const lonSpan = b.lonMax - b.lonMin
+  const latSpan = b.latMax - b.latMin
+  let heights = new Float32Array(gw * gh)
+  let bad = 0, sum = 0
+  for (let y = 0; y < gh; y++) {
+    const lat = b.latMax - (y / (gh - 1)) * latSpan
+    for (let x = 0; x < gw; x++) {
+      const lon = to360(b.lonMin + (x / (gw - 1)) * lonSpan)
+      const h = heightAt(lat, lon)
+      if (Number.isFinite(h)) { heights[y * gw + x] = h; sum += h } else { heights[y * gw + x] = NaN; bad++ }
+    }
+  }
+  if (bad / heights.length > 0.05) throw new RouteError('no_data', 'Elevation data does not cover this area.')
+  if (bad) {
+    const mean = sum / (heights.length - bad)
+    for (let i = 0; i < heights.length; i++) if (Number.isNaN(heights[i])) heights[i] = mean
+  }
+  // 8-bit DEM tiles quantise heights into steps; a light blur keeps those steps from looking like cliffs.
+  if (spec.cellKm <= 1.5) heights = blur3(heights, gw, gh)
+
+  const dxRow = new Float32Array(gh)
+  for (let y = 0; y < gh; y++) {
+    const lat = b.latMax - (y / (gh - 1)) * latSpan
+    dxRow[y] = (lonSpan / (gw - 1)) * KM_PER_DEG * Math.max(0.05, Math.cos(lat * RAD))
+  }
+  const dy = (latSpan / (gh - 1)) * KM_PER_DEG
+  return { gw, gh, heights, dxRow, dx: dxRow[gh >> 1], dy, bounds: b, lonMid: spec.lonMid }
+}
+
+const toCell = (g, lat, lon) => {
+  const b = g.bounds
+  const lonU = g.lonMid + wrapLon(lon - g.lonMid)
+  return {
+    x: ((lonU - b.lonMin) / (b.lonMax - b.lonMin)) * (g.gw - 1),
+    y: ((b.latMax - lat) / (b.latMax - b.latMin)) * (g.gh - 1),
+  }
+}
+const cellToLatLon = (g, fx, fy) => {
+  const b = g.bounds
+  return {
+    lat: b.latMax - (fy / (g.gh - 1)) * (b.latMax - b.latMin),
+    lon: to360(b.lonMin + (fx / (g.gw - 1)) * (b.lonMax - b.lonMin)),
+  }
+}
+const inGrid = (g, c) => c.x >= 0 && c.x <= g.gw - 1 && c.y >= 0 && c.y <= g.gh - 1
+
+function bilinear(g, fx, fy) {
+  const x = clamp(fx, 0, g.gw - 1), y = clamp(fy, 0, g.gh - 1)
+  const x0 = Math.min(g.gw - 2, Math.floor(x)), y0 = Math.min(g.gh - 2, Math.floor(y))
+  const u = x - x0, v = y - y0
+  const h = g.heights, w = g.gw
+  const a = h[y0 * w + x0], b = h[y0 * w + x0 + 1], c = h[(y0 + 1) * w + x0], d = h[(y0 + 1) * w + x0 + 1]
+  return a * (1 - u) * (1 - v) + b * u * (1 - v) + c * (1 - u) * v + d * u * v
+}
+
+/** Slope (degrees) of the surface at a fractional cell position. */
+function slopeAt(g, fx, fy) {
+  const row = clamp(Math.round(fy), 0, g.gh - 1)
+  const dx = g.dxRow[row]
+  const gx = (bilinear(g, fx + 0.5, fy) - bilinear(g, fx - 0.5, fy)) / dx
+  const gy = (bilinear(g, fx, fy + 0.5) - bilinear(g, fx, fy - 0.5)) / g.dy
+  return Math.atan(Math.hypot(gx, gy)) / RAD
+}
+
+function classify(slope) {
+  if (slope < 2) return 'Smooth plain'
+  if (slope < 6) return 'Undulating'
+  if (slope < 12) return 'Rocky'
+  return 'Rugged'
+}
+
+function smoothPath(nodes) {
+  const n = nodes.length
+  const k = clamp(Math.round(n / 40), 1, 4)
+  return nodes.map((p, i) => {
+    const kk = Math.min(k, i, n - 1 - i)
+    if (kk === 0) return p
+    let sx = 0, sy = 0
+    for (let j = i - kk; j <= i + kk; j++) { sx += nodes[j].fx; sy += nodes[j].fy }
+    return { fx: sx / (2 * kk + 1), fy: sy / (2 * kk + 1) }
+  })
+}
+
+export async function planRealRoute(start, end, settings, { prepareTerrain, pois = [] }) {
+  if (!start || !end || start.id === end.id) return null
+
+  const spec = gridSpec(start, end)
+  const terrain = await prepareTerrain({ bounds: spec.bounds, cellKm: spec.cellKm, gw: spec.gw, gh: spec.gh })
+  const grid = buildGrid(spec, terrain.heightAt)
+
+  const a = toCell(grid, start.lat, start.lon)
+  const b = toCell(grid, end.lat, end.lon)
+  const sCell = { x: Math.round(a.x), y: Math.round(a.y) }
+  const gCell = { x: Math.round(b.x), y: Math.round(b.y) }
+  if (sCell.x === gCell.x && sCell.y === gCell.y) {
+    throw new RouteError('too_close', 'Start and destination are closer than the terrain resolution.')
+  }
+
+  const cfg = ROUTE_MODES[settings.mode] ?? ROUTE_MODES.fastest
+  const poiCells = pois.map((p) => ({ ...p, ...toCell(grid, p.lat, p.lon) })).filter((p) => inGrid(grid, p))
+
+  // "Most Scientific": make cells near science sites cheaper to cross
+  let bonus = null
+  let minMult = 1
+  if (cfg.sciBonus && poiCells.length) {
+    minMult = 1 - cfg.sciBonus
+    bonus = new Float32Array(grid.gw * grid.gh).fill(1)
+    const r = cfg.sciRadiusKm
+    for (const p of poiCells) {
+      for (let y = 0; y < grid.gh; y++) {
+        const dxr = grid.dxRow[y]
+        for (let x = 0; x < grid.gw; x++) {
+          const km = Math.hypot((x - p.x) * dxr, (y - p.y) * grid.dy)
+          if (km > r * 3) continue
+          const m = 1 - cfg.sciBonus * Math.exp(-(km * km) / (r * r))
+          const i = y * grid.gw + x
+          if (m < bonus[i]) bonus[i] = m
+        }
+      }
+    }
+  }
+
+  const path = findPath(grid, sCell, gCell, {
+    maxSlope: settings.maxSlopeDeg,
+    slopeWeight: cfg.slopeWeight * (settings.avoidRough ? 1.5 : 1),
+    bonus,
+    minMult,
+  })
+  if (!path || path.length < 2) {
+    throw new RouteError('blocked', `No route found within your ${settings.maxSlopeDeg}° slope limit. Raise the limit or pick another mode.`)
+  }
+
+  // ---- smooth the staircase path, then measure it ----
+  const nodes = smoothPath(path.map((c) => ({ fx: c.x, fy: c.y })))
+  nodes[0] = { fx: a.x, fy: a.y }
+  nodes[nodes.length - 1] = { fx: b.x, fy: b.y }
+  const cum = [0]
+  for (let i = 1; i < nodes.length; i++) {
+    cum.push(cum[i - 1] + haversineKm(cellToLatLon(grid, nodes[i - 1].fx, nodes[i - 1].fy), cellToLatLon(grid, nodes[i].fx, nodes[i].fy)))
+  }
+  const total = cum[cum.length - 1]
+  const distanceKm = Math.max(1, Math.round(total))
+
+  // ---- resample at even spacing for the chart, map and hazard checks ----
+  const N = clamp(Math.round(total / Math.max(1, grid.dy)), 30, 120)
+  const points = []
+  let seg = 0
+  for (let i = 0; i <= N; i++) {
+    const target = (i / N) * total
+    while (seg < cum.length - 2 && cum[seg + 1] < target) seg++
+    const span = cum[seg + 1] - cum[seg] || 1
+    const t = clamp((target - cum[seg]) / span, 0, 1)
+    const fx = nodes[seg].fx + (nodes[seg + 1].fx - nodes[seg].fx) * t
+    const fy = nodes[seg].fy + (nodes[seg + 1].fy - nodes[seg].fy) * t
+    const { lat, lon } = cellToLatLon(grid, fx, fy)
+    const elevKm = bilinear(grid, fx, fy)
+    const slope = slopeAt(grid, fx, fy)
+    points.push({
+      km: +((i / N) * distanceKm).toFixed(1), lat, lon,
+      elevKm: +elevKm.toFixed(3), slopeDeg: +slope.toFixed(1),
+      terrain: classify(slope), tempC: estimateTempC(lat, elevKm),
+    })
+  }
+
+  // ---- science stops: catalogued sites that lie close to the path ----
+  const reach = Math.max(POI_NEAR_KM, grid.dy * 0.75)
+  const stops = []
+  if (settings.showScience) {
+    for (const p of poiCells) {
+      let best = Infinity, bestI = 0
+      for (let i = 0; i < nodes.length; i++) {
+        const q = cellToLatLon(grid, nodes[i].fx, nodes[i].fy)
+        const d = haversineKm(p, q)
+        if (d < best) { best = d; bestI = i }
+      }
+      if (best <= reach) {
+        stops.push({
+          id: `poi-${p.id}`, title: p.name, source: p.source || 'NASA orbital data', detail: p.note,
+          km: Math.round((cum[bestI] / total) * distanceKm), lat: p.lat, lon: to360(p.lon),
+          elevKm: +bilinear(grid, p.x, p.y).toFixed(2), offRouteKm: +best.toFixed(1),
+        })
+      }
+    }
+    stops.sort((x, y) => x.km - y.km)
+  }
+
+  return finalizeRoute({
+    start, end, settings, points, distanceKm, stops: stops.slice(0, 8),
+    dataSource: { ...terrain.source, resolutionKm: +spec.cellKm.toFixed(2) },
+  })
+}
diff --git a/src/lib/realRoute.test.js b/src/lib/realRoute.test.js
new file mode 100644
index 0000000..15077d1
--- /dev/null
+++ b/src/lib/realRoute.test.js
@@ -0,0 +1,91 @@
+// Run with: npm test   (uses Node's built-in test runner, no extra dependencies)
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { planRealRoute, gridSpec, RouteError } from './realRoute.js'
+import { haversineKm } from './routeAnalysis.js'
+
+const NILI = { id: 'nili', name: 'Nili Fossae', lat: 21.0, lon: 74.5 }
+const JEZERO = { id: 'jezero', name: 'Jezero Crater', lat: 18.435, lon: 77.527 }
+const VALLES = { id: 'valles', name: 'Valles Marineris', lat: -13.9, lon: 301.0 }
+
+const settings = (over = {}) => ({
+  mode: 'fastest', maxSlopeDeg: 15, avoidRough: true, showScience: true, evaHoursPerSol: 6, ...over,
+})
+
+// A tall Gaussian mountain sitting on the straight line between Nili and Jezero.
+const mid = { lat: (NILI.lat + JEZERO.lat) / 2, lon: (NILI.lon + JEZERO.lon) / 2 }
+const mountain = (lat, lon) => {
+  const d = haversineKm({ lat, lon }, mid)
+  return -2 + 7 * Math.exp(-(d * d) / (2 * 12 * 12))
+}
+const terrainOf = (heightAt) => ({ prepareTerrain: async () => ({ heightAt, source: { real: true, name: 'test' } }) })
+
+test('flat terrain gives a near straight-line route', async () => {
+  const r = await planRealRoute(NILI, JEZERO, settings(), terrainOf(() => -2))
+  const gc = haversineKm(NILI, JEZERO)
+  assert.ok(r.distanceKm >= gc * 0.98 && r.distanceKm < gc * 1.12, `${r.distanceKm} vs great circle ${gc}`)
+  assert.ok(r.maxSlopeDeg < 1)
+  assert.equal(r.dataSource.real, true)
+})
+
+test('route detours around a mountain instead of climbing it', async () => {
+  const flat = await planRealRoute(NILI, JEZERO, settings(), terrainOf(() => -2))
+  const hill = await planRealRoute(NILI, JEZERO, settings({ mode: 'safest' }), terrainOf(mountain))
+  assert.ok(hill.distanceKm > flat.distanceKm, 'should be longer than the flat route')
+  const peak = Math.max(...hill.points.map((p) => p.elevKm))
+  assert.ok(peak < 1.5, `route should skirt the summit, peak was ${peak} km`)
+  assert.ok(hill.maxSlopeDeg <= 15 + 1)
+})
+
+test('safest mode never climbs more than fastest mode', async () => {
+  const fast = await planRealRoute(NILI, JEZERO, settings({ mode: 'fastest' }), terrainOf(mountain))
+  const safe = await planRealRoute(NILI, JEZERO, settings({ mode: 'safest' }), terrainOf(mountain))
+  assert.ok(safe.maxSlopeDeg <= fast.maxSlopeDeg + 0.5)
+})
+
+test('impassable terrain reports a clear error', async () => {
+  const wall = (lat, lon) => (lon > mid.lon ? 8 : -2) // vertical cliff between start and goal
+  await assert.rejects(
+    planRealRoute(NILI, JEZERO, settings({ maxSlopeDeg: 5 }), terrainOf(wall)),
+    (e) => e instanceof RouteError && e.code === 'blocked',
+  )
+})
+
+test('science stops are only real catalogued sites near the path', async () => {
+  const pois = [
+    { id: 'near', name: 'Near site', lat: 19.7, lon: 76.0, note: 'on the way', source: 'MRO CRISM' },
+    { id: 'far', name: 'Far site', lat: -4.6, lon: 137.4, note: 'other side of Mars' },
+  ]
+  const r = await planRealRoute(NILI, JEZERO, settings({ mode: 'scientific' }), { ...terrainOf(() => -2), pois })
+  assert.deepEqual(r.stops.map((s) => s.id), ['poi-near'])
+  assert.equal(r.stops[0].source, 'MRO CRISM')
+  const none = await planRealRoute(NILI, JEZERO, settings({ showScience: false }), { ...terrainOf(() => -2), pois })
+  assert.equal(none.stops.length, 0)
+})
+
+test('long route across the 0/360 longitude seam works and stays monotonic', async () => {
+  const a = { id: 'a', name: 'A', lat: -1.95, lon: 354.47 }
+  const b = { id: 'b', name: 'B', lat: 4.5, lon: 20.0 }
+  const r = await planRealRoute(a, b, settings(), terrainOf(() => 0))
+  const gc = haversineKm(a, b)
+  assert.ok(r.distanceKm >= gc * 0.97 && r.distanceKm < gc * 1.2, `${r.distanceKm} vs ${gc}`)
+  for (let i = 1; i < r.points.length; i++) assert.ok(r.points[i].km >= r.points[i - 1].km)
+  assert.ok(r.points.every((p) => p.lon >= 0 && p.lon < 360))
+})
+
+test('very long route (Valles to Jezero) uses a coarse grid and says so', async () => {
+  const spec = gridSpec(VALLES, JEZERO)
+  assert.ok(spec.cellKm > 10)
+  const r = await planRealRoute(VALLES, JEZERO, settings(), terrainOf(() => -2))
+  assert.ok(r.warnings.some((w) => w.title === 'Coarse terrain model'))
+})
+
+test('route object has every field the UI reads', async () => {
+  const r = await planRealRoute(NILI, JEZERO, settings(), terrainOf(mountain))
+  for (const k of ['distanceKm', 'sols', 'elevationGainKm', 'maxSlopeDeg', 'minTempC', 'radiationMsv', 'risk', 'riskLabel', 'points', 'path', 'warnings', 'stops', 'start', 'end']) {
+    assert.ok(k in r, `missing ${k}`)
+  }
+  const p = r.points[0]
+  for (const k of ['km', 'lat', 'lon', 'elevKm', 'slopeDeg', 'terrain', 'tempC']) assert.ok(k in p, `point missing ${k}`)
+  assert.equal(r.points[r.points.length - 1].km, r.distanceKm)
+})
diff --git a/src/lib/routeAnalysis.js b/src/lib/routeAnalysis.js
